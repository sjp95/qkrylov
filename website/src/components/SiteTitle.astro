---
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import type { Props } from '@astrojs/starlight/props';

// When CI builds the docs, ASTRO_BASE_PATH is set to e.g. /qkrylov/v1.4
const currentPath = Astro.url.pathname;
let currentVersion = 'dev'; // fallback default

// Try to infer current version from URL segment
const match = currentPath.match(/^\/qkrylov\/(dev|v\d+\.\d+)/);
if (match) {
  currentVersion = match[1];
}

// Fallback initial render (prevents layout shift before JS loads)
const versions = ['dev', 'v0.1.4'];
const sortedVersions = versions.sort((a, b) => {
  if (a === 'dev') return -1;
  if (b === 'dev') return 1;
  const aNum = parseFloat(a.replace('v', ''));
  const bNum = parseFloat(b.replace('v', ''));
  return bNum - aNum; 
});
const latestRelease = sortedVersions.find(v => v !== 'dev');
---

<div class="versioned-title">
  <Default {...Astro.props} />
  
  <div class="version-picker">
    <select id="docs-version-select" aria-label="Select Documentation Version">
      {sortedVersions.map(v => {
        let label = v;
        if (v === 'dev') label = 'nightly';
        else if (v === latestRelease) label = `${v} (latest)`;
        
        return <option value={v} selected={v === currentVersion}>{label}</option>
      })}
    </select>
  </div>
</div>

<script>
  async function initVersionDropdown() {
    const select = document.getElementById('docs-version-select');
    if (!select) return;

    // Determine base path dynamically
    const isGhPages = window.location.pathname.startsWith('/qkrylov');
    const basePath = isGhPages ? '/qkrylov' : '';
    
    try {
      // Fetch dynamic versions list
      const res = await fetch(`${basePath}/versions.json`);
      if (res.ok) {
        const versions = await res.json();
        
        const sortedVersions = versions.sort((a, b) => {
          if (a === 'dev') return -1;
          if (b === 'dev') return 1;
          const aNum = parseFloat(a.replace('v', ''));
          const bNum = parseFloat(b.replace('v', ''));
          return bNum - aNum; 
        });

        const latestRelease = sortedVersions.find(v => v !== 'dev');
        
        // Infer current version
        const currentPath = window.location.pathname;
        let currentVersion = 'dev';
        const match = currentPath.match(/^\/qkrylov\/(dev|v\d+\.\d+)/);
        if (match) {
          currentVersion = match[1];
        } else {
           const localMatch = currentPath.match(/^\/(dev|v\d+\.\d+)/);
           if (localMatch) currentVersion = localMatch[1];
        }

        // Re-populate select
        select.innerHTML = '';
        sortedVersions.forEach(v => {
          let label = v;
          if (v === 'dev') label = 'nightly';
          else if (v === latestRelease) label = `${v} (latest)`;
          
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = label;
          if (v === currentVersion) opt.selected = true;
          select.appendChild(opt);
        });
      }
    } catch (e) {
      console.warn("Failed to load dynamic versions.json, keeping fallback.", e);
    }

    // Handle navigation
    select.addEventListener('change', (e) => {
      const targetVersion = (e.target as HTMLSelectElement).value;
      const currentUrl = new URL(window.location.href);
      const pathParts = currentUrl.pathname.split('/').filter(Boolean);
      
      let newPath = '';
      if (pathParts[0] === 'qkrylov') {
        const hasVersion = pathParts.length > 1 && (pathParts[1] === 'dev' || pathParts[1].match(/^v\d+\.\d+/));
        if (hasVersion) {
          pathParts[1] = targetVersion;
        } else {
          pathParts.splice(1, 0, targetVersion);
        }
        newPath = '/' + pathParts.join('/') + '/';
      } else {
        const hasVersion = pathParts.length > 0 && (pathParts[0] === 'dev' || pathParts[0].match(/^v\d+\.\d+/));
        if (hasVersion) {
          pathParts[0] = targetVersion;
        } else {
          pathParts.unshift(targetVersion);
        }
        newPath = '/' + pathParts.join('/') + '/';
      }
      
      window.location.pathname = newPath;
    });
  }

  // Run on load
  initVersionDropdown();
</script>

<style>
  .versioned-title {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .version-picker select {
    background-color: var(--sl-color-bg-nav);
    color: var(--sl-color-text-accent);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.15rem 0.5rem;
    font-size: var(--sl-text-sm);
    cursor: pointer;
    outline: none;
    font-weight: 500;
  }
  
  .version-picker select:hover {
    border-color: var(--sl-color-gray-4);
  }
</style>
